# Нагрузочный стенд: отдельная база и отдельный vhost RabbitMQ, чтобы
# сотни тестовых тикетов не смешивались с рабочими данными и чтобы рабочий
# consumer не получал чужие события.
DATABASE_URL=postgresql+psycopg://support:support@localhost:5433/support_load
RABBITMQ_URL=amqp://support:support@localhost:5672/load

EMBEDDING_PROVIDER=hashing
RAG_CONFIDENCE_THRESHOLD=0.15
WS_BRIDGE_ENABLED=false

# Задержка LLM по p95-бюджету шагов из раздела «Бюджет задержки».
SIMULATED_LLM_CLASSIFY_MS=2000
SIMULATED_LLM_GENERATE_MS=4500
