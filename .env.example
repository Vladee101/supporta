# --- Инфраструктура ---
# Порты хоста для docker compose. Меняйте, если 5432/5672 уже заняты
# локальными установками PostgreSQL или RabbitMQ (порт в DATABASE_URL - тот же).
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support
RABBITMQ_URL=amqp://support:support@localhost:5672/

# Ёмкость процесса API (NFR8). Потоков - не меньше одновременных тикетов:
# тикет занимает поток на время ожидания LLM. Соединения на это время
# освобождаются, поэтому пул базы может быть заметно меньше.
API_WORKER_THREADS=100
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Таймаут подключения к Postgres, сек: без него воркер может зависнуть навсегда.
DB_CONNECT_TIMEOUT_SECONDS=5

# --- Пороги маршрутизации ---
# Не константы домена, а калибруемые значения (см. «Confidence и пороги» в design document).
# Смена embedding-модели или LLM-провайдера требует повторной калибровки.
CLASS_CONFIDENCE_THRESHOLD=0.85
RAG_CONFIDENCE_THRESHOLD=0.6
MAX_CLARIFICATIONS=1

# --- Таймауты (NFR9, NFR4, claim) ---
CLARIFICATION_TIMEOUT_MINUTES=30
ESCALATION_CLAIM_TTL_MINUTES=15
CLIENT_ESCALATION_WINDOW_HOURS=24
RAW_TICKET_RETENTION_DAYS=90

# --- RAG ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RAG_TOP_K=5
# ADR-010: hybrid - вектор + полнотекстовый поиск (русская морфология), слияние по RRF; vector - только вектор.
RAG_RETRIEVAL_MODE=hybrid
# Кандидатов от каждой ветки гибрида до слияния.
RAG_CANDIDATES=20
# auto | bge | hashing. Порог RAG откалиброван под конкретный провайдер:
# 0.6 - калибровка под bge-m3 (scripts.calibrate_rag); для hashing (без модели) - ~0.15.
EMBEDDING_PROVIDER=auto

# --- Каналы приёма (UC1) ---
# JSON: канал → секрет подписи вебхука. Канала нет в списке - он не поддерживается.
CHANNEL_SECRETS={"web": "dev-only-web-secret"}
TICKET_TOKEN_TTL_HOURS=168

# --- LLM-провайдер (ADR-009) ---
# baseline - без сети и ключей; openai_compatible - YandexGPT, vLLM; gigachat - Сбер.
LLM_PROVIDER=baseline
LLM_CLASSIFY_MODEL=
LLM_GENERATE_MODEL=
# auto: logprobs, если провайдер их отдаёт, иначе k-sampling (стоимость классификации ×k).
LLM_CONFIDENCE_MODE=auto
# ADR-012: без logprobs голоса почти всегда единогласны, и k > 1 только умножает цену.
# Сигнал уверенности даёт сверка с базовой линией (LLM_CROSS_CHECK).
LLM_K_SAMPLES=1
LLM_CROSS_CHECK=true
LLM_SAMPLING_TEMPERATURE=0.7
# NFR6: повторы временных сбоев в пределах дедлайна, затем эскалация.
LLM_MAX_RETRIES=3
LLM_RETRY_DEADLINE_SECONDS=10
LLM_REQUEST_TIMEOUT_SECONDS=8
# Бандл корневых сертификатов (GigaChat подписан Russian Trusted Root CA).
LLM_CA_BUNDLE=

# openai_compatible. YandexGPT: https://llm.api.cloud.yandex.net/v1,
# модели gpt://<folder_id>/yandexgpt-lite/latest и gpt://<folder_id>/yandexgpt/latest.
# vLLM: http://<host>:8000/v1 и LLM_CHOICE_CONSTRAINT=guided_choice (или structured_outputs).
LLM_BASE_URL=
LLM_API_KEY=
LLM_AUTH_SCHEME=Bearer
LLM_CHOICE_CONSTRAINT=none

# gigachat: ключ авторизации (base64) из личного кабинета; модели GigaChat-2 / GigaChat-2-Pro.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# --- Операторы и консоль ---
# Секрет подписи токенов операторов. Значение по умолчанию - только для
# локальной разработки; в любом общем окружении обязательно своё.
AUTH_SECRET=dev-only-insecure-secret-change-me
OPERATOR_TOKEN_TTL_HOURS=12
# Мост RabbitMQ → WebSocket в процессе API (push эскалаций в консоль).
WS_BRIDGE_ENABLED=false
